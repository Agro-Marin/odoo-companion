# The pinned static-analysis tools, in one place.
#
# `tools/lint.sh` and `.github/workflows/ci.yml` both read this. They used to
# state it separately -- which is to say only the workflow stated it, and
# `lint.sh` ran whatever was on PATH. A developer on ktlint 1.5.0 and a CI job on
# 1.3.1 then disagreed about a clean tree in both directions: 1.5.0 joins a
# multi-line parameter list onto one line and leaves its trailing comma, which
# 1.3.1 rejects and cannot autocorrect. The workflow's own comment said the pin
# existed to prevent exactly that.
#
# Moving a pin is a decision, not a chore: these tools are exact in both
# directions, so a version whose rules shifted turns a clean tree red and a red
# tree clean. Change it here, run `tools/lint.sh --fix`, and commit the result
# with it.
KTLINT_VERSION=1.8.0
DETEKT_VERSION=1.23.8

# The JDK CI builds on. Stated here for the same reason, but it cannot be
# enforced the same way: `tools/lint.sh` can refuse a linter that is not the
# pin, while refusing to build on the wrong JDK would mean a Gradle toolchain,
# which fails outright -- offline included -- on any machine without that exact
# JDK installed.
#
# This is now a floor and not only a preference. `compileOptions` and the
# `kotlin.compilerOptions.jvmTarget` that replaced `kotlinOptions` in Kotlin 2.3
# both say 25, so a JDK below 25 no longer builds this project at all: it cannot
# emit class file version 69. An older JDK fails in the Kotlin compile task
# rather than here, which is the cost of not declaring a Gradle toolchain -- and
# that remains the right trade, because a toolchain fails outright, offline
# included, on any machine that does not already have exactly this JDK.
#
# Nothing about Android requires the bytecode to be 25: D8 rewrites it to DEX
# either way, and the project compiles no Java of its own, so
# sourceCompatibility and targetCompatibility govern nothing it actually has.
# The number is aligned with the JDK CI builds on so there is one version to
# reason about instead of two.
JAVA_VERSION=25
