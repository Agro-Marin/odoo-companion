<?xml version="1.0" encoding="utf-8"?>
<!-- A field's outline: hairline at rest, the accent while it has focus. The
     guide lights one field and then puts this list back. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_primary" android:state_focused="true" />
    <item android:alpha="0.5" android:color="@color/hairline" android:state_enabled="false" />
    <item android:color="@color/hairline" />
</selector>
