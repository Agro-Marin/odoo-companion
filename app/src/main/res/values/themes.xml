<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Geometric sans for what is read, mono for what is measured (counts,
         times, identifiers, section labels); squarer corners throughout. -->
    <style name="Theme.Companion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorSurface">@color/canvas</item>
        <item name="colorSurfaceContainerLowest">@color/panel</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="colorOutlineVariant">@color/hairline</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.Companion.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Companion.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Companion.Medium</item>
        <item name="textInputStyle">@style/Widget.Companion.TextInput</item>
        <item name="materialButtonStyle">@style/Widget.Companion.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Companion.Card</item>
    </style>

    <style name="Shape.Companion.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Companion.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Companion.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
    </style>

    <style name="Widget.Companion.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Companion.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Companion.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/panel</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- A section label: small, spaced, monospaced and muted. -->
    <style name="Text.Companion.Label" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Text.Companion.Figure" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="Text.Companion.Mono" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
</resources>
