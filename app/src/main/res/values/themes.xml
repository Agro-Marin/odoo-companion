<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Companion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/brand_on_accent</item>
        <item name="colorPrimaryContainer">@color/tile</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondaryContainer">@color/brand_accent</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_accent</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorSurface">@color/canvas</item>
        <item name="colorSurfaceContainerLowest">@color/panel</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="colorOutlineVariant">@color/hairline</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:fontFamily">@font/archivo_narrow</item>
        <item name="fontFamily">@font/archivo_narrow</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.Companion.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Companion.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Companion.Medium</item>
        <item name="textInputStyle">@style/Widget.Companion.TextInput</item>
        <item name="materialButtonStyle">@style/Widget.Companion.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Companion.Card</item>
    </style>

    <style name="Shape.Companion.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Companion.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Companion.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
    </style>

    <style name="Widget.Companion.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- An entry of the gear's menu: an icon and a label, no box. -->
    <style name="Widget.Companion.Button.Menu" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="iconTint">@null</item>
        <item name="iconPadding">14dp</item>
        <item name="iconSize">22dp</item>
    </style>

    <!-- One segment of a choice of three, such as the appearance. -->
    <style name="Widget.Companion.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="backgroundTint">@color/segment_fill</item>
        <item name="strokeColor">@color/hairline</item>
    </style>

    <!-- A Home tile: one of the two ways to send a document. -->
    <style name="Widget.Companion.Tile" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/tile</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">156dp</item>
    </style>

    <style name="Widget.Companion.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/panel</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="Text.Companion.Title" parent="">
        <item name="android:fontFamily">@font/special_gothic_expanded</item>
        <item name="fontFamily">@font/special_gothic_expanded</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Companion.Label" parent="">
        <item name="android:fontFamily">@font/special_gothic_expanded</item>
        <item name="fontFamily">@font/special_gothic_expanded</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Text.Companion.Figure" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="Text.Companion.Mono" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
</resources>
