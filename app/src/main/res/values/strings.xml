    <string name="new_icon_title">A new icon</string>
    <string name="new_icon_body">Companion now carries the Odoo ring in Xiuman colours. Look for it on your home screen.</string>
    <string name="new_scan_title">Send documents to Odoo</string>
    <string name="new_scan_body">Scan with the camera or upload a PDF or a photo: it reaches Odoo\'s Documents in your name.</string>
    <string name="new_widget_title">Scan from anywhere</string>
    <string name="new_widget_body">Touch and hold your home screen, choose Widgets and add Companion\'s Scan button. The notification on the lock screen has a Scan button too.</string>
    <string name="new_update_title">Updates by themselves</string>
    <string name="new_update_body">When there is a new version, Home shows it with its progress, and the app reopens once it is installed.</string>
    <string name="new_admin_title">Protected settings</string>
    <string name="new_admin_body">The gear\'s Settings now ask for the administrator password. The version you have is at the bottom of Home.</string>
    <string name="new_lock_widget_title">Scan from the lock screen</string>
    <string name="new_lock_widget_body">The Scan widget now works on the home screen and can go on the lock screen: touch and hold the lock screen, choose Widgets and add Companion. Tapping it asks you to unlock and opens the scanner.</string>
