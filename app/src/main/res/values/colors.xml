<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Xiuman palette (brandbook v1.0, section 07): Noche #023E4C
         carries the ink and the filled actions, Fértil #2EB769 the accent,
         Mineral #FCF8F2 the canvas, Rocío #B4D5D6 the secondary ink at night.
         Fértil is never text on a light canvas (it holds 2:1 there), so it
         only fills shapes, always with Noche on top (4.5:1). -->
    <color name="xiuman_fertil">#2EB769</color>
    <color name="xiuman_mineral">#FCF8F2</color>
    <color name="xiuman_noche">#023E4C</color>

    <color name="brand_primary">#023E4C</color>
    <color name="brand_on_primary">#FCF8F2</color>
    <color name="brand_accent">#2EB769</color>
    <color name="brand_on_accent">#023E4C</color>
    <color name="ink">#023E4C</color>
    <color name="ink_muted">#4A6970</color>
    <color name="canvas">#FCF8F2</color>
    <color name="panel">#FFFFFF</color>
    <color name="tile">#EAF4F1</color>
    <color name="hairline">#D3E3E2</color>
    <color name="logo_ink">#023E4C</color>
    <color name="alert_bg">#FFF4DB</color>
    <color name="alert_ink">#6E4A00</color>
</resources>
