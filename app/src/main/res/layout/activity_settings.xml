<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: everything that configures the phone and reports on it, out of
     Home's way. Status first (the first thing anyone reads when a phone
     stopped reporting), then the connection, the reporting cadence, what is
     sent, the appearance and the WhatsApp documents report. Save sits in the
     bar, since it writes this whole form at once.

     Every field is wrapped in a TextInputLayout rather than carrying a hint of
     its own. A hint is only drawn while the field is empty, so the moment a
     phone is enrolled the whole form turns into five unlabelled values, two of
     them bare numbers whose unit lives only in the string the user can no
     longer see. A floating label survives the field being filled in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/settingsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/form_side_margin">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Text.Companion.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/settings_title"
                android:textSize="18sp" />

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_save" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="@dimen/form_side_margin"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/form_side_margin"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Companion.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/section_status" />

                <include
                    android:id="@+id/alerts"
                    layout="@layout/alert_band" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statusPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_field">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/panel_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/statePill"
                                layout="@layout/state_pill" />

                            <TextView
                                android:id="@+id/managedBadge"
                                style="@style/Text.Companion.Mono"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/status_managed"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lastUpload"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/lastAttempt"
                            style="@style/Text.Companion.Mono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/lastError"
                            style="@style/Text.Companion.Mono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/alert_ink"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@color/hairline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/queuePositions"
                                    style="@style/Text.Companion.Figure"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    style="@style/Text.Companion.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/figure_positions" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/queueCalls"
                                    style="@style/Text.Companion.Figure"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    style="@style/Text.Companion.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/figure_calls" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/queueRecordings"
                                    style="@style/Text.Companion.Figure"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    style="@style/Text.Companion.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/figure_recordings" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/queueDocuments"
                                    style="@style/Text.Companion.Figure"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    style="@style/Text.Companion.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/figure_documents" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/heldBand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/heldText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/alert_ink"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/heldSend"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/action_held_send" />

                                <Button
                                    android:id="@+id/heldDiscard"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/action_held_discard" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Text.Companion.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_block"
                    android:layout_marginBottom="6dp"
                    android:text="@string/section_connection" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/baseUrlLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/gap_field"
                    android:hint="@string/config_server">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/baseUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="url"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/identifierLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/gap_field"
                    android:hint="@string/config_identifier">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/identifier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="username"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tokenLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/gap_field"
                    android:hint="@string/config_token"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/token"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Text.Companion.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_block"
                    android:layout_marginBottom="6dp"
                    android:text="@string/section_reporting" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/locationIntervalLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="@dimen/gap_field"
                        android:layout_weight="1"
                        android:hint="@string/config_location_interval_short">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/locationInterval"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints=""
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/uploadWindowLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/gap_field"
                        android:layout_weight="1"
                        android:hint="@string/config_upload_window_short">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/uploadWindow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints=""
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    style="@style/Text.Companion.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_block"
                    android:layout_marginBottom="6dp"
                    android:text="@string/section_sending" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/callLogEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/restriction_call_log_title"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/recordingsEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/restriction_recordings_title"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wifiOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/restriction_wifi_only_title"
                    android:textSize="15sp" />

                <!-- Light, dark, or whatever the system says; applied at once
                     and kept on this phone only, never sent to Odoo. -->
                <TextView
                    style="@style/Text.Companion.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_block"
                    android:layout_marginBottom="8dp"
                    android:text="@string/section_appearance" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/appearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/appearanceSystem"
                        style="@style/Widget.Companion.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/appearance_system" />

                    <Button
                        android:id="@+id/appearanceLight"
                        style="@style/Widget.Companion.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/appearance_light" />

                    <Button
                        android:id="@+id/appearanceDark"
                        style="@style/Widget.Companion.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/appearance_dark" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- The WhatsApp documents report: what the notices announced
                     and whether the file was found, read on the handset before
                     anything is uploaded. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_block"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Companion.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_whatsapp" />

                    <Button
                        android:id="@+id/whatsappEnable"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/action_whatsapp_enable"
                        android:textColor="@color/ink"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/whatsappPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_field">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/panel_padding">

                        <TextView
                            android:id="@+id/whatsappState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="12dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            app:drawableStartCompat="@drawable/ic_whatsapp_docs" />

                        <TextView
                            android:id="@+id/whatsappSightings"
                            style="@style/Text.Companion.Mono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="2dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/appVersion"
                    style="@style/Text.Companion.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_block"
                    android:gravity="center_horizontal"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- The enrolment guide, docked over the bottom of the form. -->
    <FrameLayout
        android:id="@+id/guideDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="@dimen/form_side_margin"
        android:paddingEnd="@dimen/form_side_margin">

        <include
            android:id="@+id/guideBaseUrl"
            layout="@layout/guide_card" />

        <include
            android:id="@+id/guideIdentifier"
            layout="@layout/guide_card" />

        <include
            android:id="@+id/guideToken"
            layout="@layout/guide_card" />
    </FrameLayout>
</FrameLayout>
