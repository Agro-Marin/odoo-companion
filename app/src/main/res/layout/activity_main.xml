<?xml version="1.0" encoding="utf-8"?>
<!-- Home: what the person holding the phone came to do, send a document,
     and nothing else. Whether the phone is enrolled stays in the header, an
     alert that needs a hand keeps its band, and everything that configures
     the phone lives behind the gear, in Settings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="@dimen/form_side_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/form_side_margin"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The symbol and the name, whether this phone is enrolled, and
                 the gear. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brand_symbol" />

                <TextView
                    style="@style/Text.Companion.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_title"
                    android:textSize="18sp" />

                <include
                    android:id="@+id/statePill"
                    layout="@layout/state_pill" />

                <ImageButton
                    android:id="@+id/actionsToggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/actions_menu"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <include
                android:id="@+id/alerts"
                layout="@layout/alert_band" />

            <!-- A newer build published on GitHub, offered once it is known. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tile"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/panel_padding">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_update" />

                    <TextView
                        android:id="@+id/updateText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/updateInstall"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/update_install"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- A phone that is not enrolled sends nothing: the way to fix that
                 comes first. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/enrollPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/panel_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_enroll_prompt"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/enrollOpenSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/action_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.Companion.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/home_headline"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_subline"
                android:textColor="@color/ink_muted"
                android:textSize="15sp" />

            <!-- The two ways in: scan a page, or pick a file already on the
                 phone. Big icons, one word each. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/scanDocument"
                    style="@style/Widget.Companion.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/action_scan"
                    app:cardBackgroundColor="@color/brand_accent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_scan_on_accent" />

                        <TextView
                            style="@style/Text.Companion.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="@string/action_scan"
                            android:textColor="@color/brand_on_accent"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_scan_hint"
                            android:textColor="@color/brand_on_accent"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pickDocument"
                    style="@style/Widget.Companion.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/action_pick_file">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_upload" />

                        <TextView
                            style="@style/Text.Companion.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="@string/action_pick_file_short"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_pick_hint"
                            android:textColor="@color/ink_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/scanState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/scanRecent"
                style="@style/Text.Companion.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- The actions, behind the gear: a scrim that closes the menu on any tap
         outside it, and the menu itself under the gear. -->
    <View
        android:id="@+id/actionsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="false"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/actionsMenu"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="@dimen/form_side_margin"
        android:visibility="gone"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <Button
                android:id="@+id/openSettings"
                style="@style/Widget.Companion.Button.Menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_settings"
                app:icon="@drawable/ic_settings" />

            <Button
                android:id="@+id/syncNow"
                style="@style/Widget.Companion.Button.Menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_sync_now"
                app:icon="@drawable/ic_sync" />

            <Button
                android:id="@+id/grantPermissions"
                style="@style/Widget.Companion.Button.Menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_grant"
                app:icon="@drawable/ic_permissions" />

            <Button
                android:id="@+id/checkUpdate"
                style="@style/Widget.Companion.Button.Menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_check_update"
                app:icon="@drawable/ic_update" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
